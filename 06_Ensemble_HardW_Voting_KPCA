===========\n","# GRIDS DE HIPERPARÁMETROS (ADAPTADOS PARA ENSAMBLE)\n","# =========================================================\n","\n","GRID_PCA = {'reduccion__n_components': [0.95]}\n","\n","GRID_KPCA = [\n","    {\n","        'reduccion__kernel': ['poly'],\n","        'reduccion__n_components': [32],\n","        'reduccion__degree': [2, 3],\n","        'reduccion__gamma': [None]\n","    }\n","]\n","\n","# Grid base para los modelos dentro del ensamble\n","# (Mantenido acotado para evitar tiempos de cómputo infinitos)\n","GRID_MODELOS_ENSAMBLE = {\n","    'ensamble__lr__C': [0.01, 0.1, 1.0],\n","    'ensamble__lr__max_iter': [200, 500],\n","    'ensamble__rf__n_estimators': [50, 100, 200],\n","    'ensamble__rf__max_features': ['sqrt']\n","}"]},{"cell_type":"code","source":["# =========================================================\n","# 2. FUNCIÓN DE ENSAMBLE HARD VOTING OPTIMIZADA\n","# =========================================================\n","def ensamble_hard_pesos_nested(datos, nombre_reduccion, acc_lr, acc_rf, acc_nb):\n","    # Cálculo dinámico de pesos\n","    peso_lr = np.log(acc_lr / (1.0 - acc_lr))\n","    peso_rf = np.log(acc_rf / (1.0 - acc_rf))\n","    peso_nb = np.log(acc_nb / (1.0 - acc_nb))\n","    pesos_calculados = [peso_lr, peso_rf, peso_nb]\n","\n","    print(f\"--- NESTED LOSO | Ensamble: HARD VOTING (Pesos) | Reducción: {nombre_reduccion.upper()} ---\")\n","    print(f\"Pesos internos (LR, RF, NB): [{peso_lr:.4f}, {peso_rf:.4f}, {peso_nb:.4f}]\")\n","\n","    X = datos.drop(columns=['activity', 'subject'])\n","    y = datos['activity']\n","    groups = datos['subject']\n","\n","    logo_outer = LeaveOneGroupOut()\n","    fold = 1\n","    accuracies, precisions, recalls, f1_scores = [], [], [], []\n","    start_time_total = time.time()\n","\n","    # OPTIMIZACIÓN A: Crear el directorio temporal para la caché al inicio del proceso\n","    cachedir = mkdtemp()\n","\n","    try:\n","        for train_index, test_index in logo_outer.split(X, y, groups):\n","            start_time_fold = time.time()\n","\n","            X_test_A = X.iloc[test_index]\n","            y_test_A = y.iloc[test_index]\n","            sujeto_evaluado = groups.iloc[test_index].unique()[0]\n","\n","            X_train_val = X.iloc[train_index]\n","            y_train_val = y.iloc[train_index]\n","            groups_train_val = groups.iloc[train_index]\n","\n","            print(f\"[Iter {fold}] Test Sujeto {sujeto_evaluado} -> \", end=\"\")\n","\n","            # 1. CONSTRUIR PIPELINE\n","            pasos_pipeline = [('scaler', StandardScaler())]\n","\n","            if nombre_reduccion == 'pca':\n","                pasos_pipeline.append(('reduccion', PCA(random_state=42)))\n","                param_grid_red = GRID_PCA\n","            elif nombre_reduccion == 'kpca':\n","                # OPTIMIZACIÓN B: Agregar eigen_solver='randomized' para resolver KPCA\n","                pasos_pipeline.append(('reduccion', KernelPCA(random_state=42, n_jobs=-1, eigen_solver='randomized')))\n","                param_grid_red = GRID_KPCA # Usamos el grid sin el grado 1\n","            elif nombre_reduccion == 'bosque':\n","                selector_rf = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)\n","                pasos_pipeline.append(('reduccion', SelectFromModel(selector_rf)))\n","                param_grid_red = {}\n","            elif nombre_reduccion == 'sin':\n","                param_grid_red = {}\n","            else:\n","                raise ValueError(\"Reducción no implementada\")\n","\n","            # Configurar Modelos Base\n","            lr = LogisticRegression(solver='lbfgs', penalty='l2', random_state=42, n_jobs=-1)\n","            rf = RandomForestClassifier(random_state=42, n_jobs=-1)\n","            nb = GaussianNB()\n","\n","            ensamble = VotingClassifier(\n","                estimators=[('lr', lr), ('rf', rf), ('nb', nb)],\n","                voting='hard',\n","                weights=pesos_calculados\n","            )\n","\n","            pasos_pipeline.append(('ensamble', ensamble))\n","\n","            # OPTIMIZACIÓN C: Instanciar el Pipeline con la memoria caché\n","            pipeline_final = Pipeline(pasos_pipeline, memory=cachedir)\n","\n","            # 2. UNIR GRIDS\n","            if isinstance(param_grid_red, list):\n","                param_grid_completo = [{**d, **GRID_MODELOS_ENSAMBLE} for d in param_grid_red]\n","            else:\n","                param_grid_completo = {**param_grid_red, **GRID_MODELOS_ENSAMBLE}\n","\n","            gkf_inner = GroupKFold(n_splits=3)\n","            search = GridSearchCV(\n","                pipeline_final,\n","                param_grid_completo,\n","                cv=gkf_inner,\n","                n_jobs=-1,\n","                scoring='accuracy'\n","            )\n","\n","            search.fit(X_train_val, y_train_val, groups=groups_train_val)\n","\n","            # 3. EXTRAER CONFIGURACIÓN GANADORA Y LIMPIAR NOMBRES\n","            mejor_pipeline = search.best_estimator_\n","            mejores_params = search.best_params_\n","\n","            # Limpieza robusta para acceder a los hiperparámetros\n","            params_limpios = {k.split('__')[-1]: v for k, v in mejores_params.items()}\n","\n","            y_pred = mejor_pipeline.predict(X_test_A)\n","\n","            accuracies.append(accuracy_score(y_test_A, y_pred))\n","            precisions.append(precision_score(y_test_A, y_pred, average='weighted', zero_division=0))\n","            recalls.append(recall_score(y_test_A, y_pred, average='weighted', zero_division=0))\n","            f1_scores.append(f1_score(y_test_A, y_pred, average='weighted', zero_division=0))\n","\n","            print(f\"Parámetros óptimos: {params_limpios} | Tiempo: {time.time() - start_time_fold:.2f} s\")\n","            fold += 1\n","\n","    finally:\n","        # OPTIMIZACIÓN D: Garantizar siempre la limpieza de la memoria temporal\n","        rmtree(cachedir)\n","\n","    print(f\"\\n==========================================\")\n","    print(f\"Tiempo total LOSO Anidado: {(time.time() - start_time_total)/60:.2f} min\")\n","    print(f\"ACCURACY FINAL : {np.mean(accuracies)*100:.2f}% (± {np.std(accuracies)*100:.2f}%)\")\n","    print(f\"PRECISION FINAL: {np.mean(precisions)*100:.2f}%\")\n","    print(f\"RECALL FINAL   : {np.mean(recalls)*100:.2f}%\")\n","    print(f\"F1-SCORE FINAL : {np.mean(f1_scores)*100:.2f}%\\n\")"],"metadata":{"id":"yoUr5Sv2YRYD","executionInfo":{"status":"ok","timestamp":1779273405553,"user_tz":360,"elapsed":68,"user":{"displayName":"Ricardo Cordova Martinez","userId":"04535966833820380904"}}},"execution_count":10,"outputs":[]},{"cell_type":"code","source":["ACC_LR = 0.9384\n","ACC_RF = 0.9056\n","ACC_NB = 0.8791\n","\n","ensamble_hard_pesos_nested(\n","    datos=df_features,\n","    nombre_reduccion='kpca',\n","    acc_lr=ACC_LR,\n","    acc_rf=ACC_RF,\n","    acc_nb=ACC_NB\n",")"],"metadata":{"id":"TX2mhezLYncQ","executionInfo":{"status":"ok","timestamp":1779285903709,"user_tz":360,"elapsed":12494809,"user":{"displayName":"Ricardo Cordova Martinez","userId":"04535966833820380904"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"1e2129c5-514b-4d72-8612-48c56e1343e6"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["--- NESTED LOSO | Ensamble: HARD VOTING (Pesos) | Reducción: KPCA ---\n","Pesos internos (LR, RF, NB): [2.7235, 2.2611, 1.9839]\n","[Iter 1] Test Sujeto 1 -> Parámetros óptimos: {'C': 10.0, 'max_iter': 200, 'max_features': 'sqrt', 'n_estimators': 50, 'degree': 2, 'gamma': None, 'kernel': 'poly', 'n_components': 32} | Tiempo: 1573.93 s\n","[Iter 2] Test Sujeto 2 -> Parámetros óptimos: {'C': 10.0, 'max_iter': 200, 'max_features': 'sqrt', 'n_estimators': 200, 'degree': 2, 'gamma': None, 'kernel': 'poly', 'n_components': 32} | Tiempo: 1574.92 s\n","[Iter 3] Test Sujeto 3 -> Parámetros óptimos: {'C': 1.0, 'max_iter': 200, 'max_features': 'sqrt', 'n_estimators': 100, 'degree': 2, 'gamma': None, 'kernel': 'poly', 'n_components': 32} | Tiempo: 1539.17 s\n","[Iter 4] Test Sujeto 4 -> Parámetros óptimos: {'C': 10.0, 'max_iter': 200, 'max_features': 'sqrt', 'n_estimators': 50, 'degree': 2, 'gamma': None, 'kernel': 'poly', 'n_components': 32} | Tiempo: 1548.79 s\n","[Iter 5] Test Sujeto 5 -> Parámetros óptimos: {'C': 1.0, 'max_iter': 200, 'max_features': 'sqrt', 'n_estimators': 100, 'degree': 2, 'gamma': None, 'kernel': 'poly', 'n_components': 32} | Tiempo: 1580.00 s\n","[Iter 6] Test Sujeto 6 -> Parámetros óptimos: {'C': 1.0, 'max_iter': 200, 'max_features': 'sqrt', 'n_estimators': 50, 'degree': 2, 'gamma': None, 'kernel': 'poly', 'n_components': 32} | Tiempo: 1551.75 s\n","[Iter 7] Test Sujeto 7 -> Parámetros óptimos: {'C': 1.0, 'max_iter': 200, 'max_features': 'sqrt', 'n_estimators': 100, 'degree': 2, 'gamma': None, 'kernel': 'poly', 'n_components': 32} | Tiempo: 1559.68 s\n","[Iter 8] Test Sujeto 8 -> Parámetros óptimos: {'C': 1.0, 'max_iter': 200, 'max_features': 'sqrt', 'n_estimators': 50, 'degree': 3, 'gamma': None, 'kernel': 'poly', 'n_components': 32} | Tiempo: 1566.51 s\n","\n","==========================================\n","Tiempo total LOSO Anidado: 208.25 min\n","ACCURACY FINAL : 91.37% (± 3.85%)\n","PRECISION FINAL: 91.84%\n","RECALL FINAL   : 91.37%\n","F1-SCORE FINAL : 90.41%\n","\n"]}]}]}